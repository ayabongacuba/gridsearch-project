{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current stage (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
      "args": ["--no-viz", "mazes/m05-caves-45.grid"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "build: current stage",
      "setupCommands": [
        {
          "description": "pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug current stage's tests (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/test_${fileBasenameNoExtension}",
      "args": ["-b"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "test: current stage",
      "setupCommands": [
        {
          "description": "pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug current stage (lldb, macOS)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
      "args": ["--no-viz", "mazes/m05-caves-45.grid"],
      "cwd": "${workspaceFolder}",
      "MIMode": "lldb",
      "preLaunchTask": "build: current stage"
    }
  ]
}
