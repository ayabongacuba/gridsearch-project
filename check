#!/usr/bin/env bash
# check -- compare your output against the expected output, map by map.
#
#   ./check dfs           every map for that stage
#   ./check dfs m05       one map
#   ./check               every stage
#
# Lines that legitimately differ between machines and between runs
# (timings, memory, how many orderings you examined) are ignored.
set -uo pipefail
cd "$(dirname "$0")"

# Lines that legitimately differ between machines and between runs. Nothing
# about the answer itself is in here: the route, the tour order, the counts
# and the rendered map are all compared exactly.
VOLATILE='^(TIME_MS|TIME_US|PEAK_KB|RELAXATIONS|TOUR_MS|TOUR_US|MATRIX_MS|CANDIDATES)'

check_one() {
  local stage=$1 map=$2 expected=$3 args=$4
  local got
  got=$(timeout 30 ./bin/"$stage" --quiet $args "maps/${map}.grid" 2>/dev/null \
        | grep -vE "$VOLATILE")
  if diff -q <(echo "$got") <(grep -vE "$VOLATILE" "$expected") >/dev/null 2>&1; then
    printf "  \033[32mok\033[0m    %s\n" "$map"
    return 0
  fi
  printf "  \033[31mFAIL\033[0m  %s\n" "$map"
  diff <(grep -vE "$VOLATILE" "$expected") <(echo "$got") \
    | head -12 | sed 's/^/        /'
  return 1
}

run_stage() {
  local stage=$1 only=${2:-}
  [[ -d "expected/$stage" ]] || return 0
  make -s "bin/$stage" >/dev/null 2>&1 || { echo "  $stage does not build"; return 1; }
  echo "== $stage"
  local pass=0 fail=0
  for e in expected/"$stage"/*.out; do
    local base map args
    base=$(basename "$e" .out)
    case "$stage" in
      floyd) map=${base%.*}; [[ $base == *.fw ]] && args="--fw" || args="--dij" ;;
      tsp)   map=$base; args="" ;;
      *)     map=$base; args="--render" ;;
    esac
    [[ -n "$only" && $map != "$only"* ]] && continue
    if check_one "$stage" "$map" "$e" "$args"; then ((pass++)); else ((fail++)); fi
  done
  echo "  $pass passed, $fail failed"
  return $(( fail > 0 ))
}

if [[ $# -eq 0 ]]; then
  rc=0
  for s in dfs bfs dijkstra astar floyd tsp; do run_stage "$s" || rc=1; done
  exit $rc
else
  run_stage "$1" "${2:-}"
fi
